{
  "name": "saucelabs-mydemo-mobile-automation",
  "version": "1.0.0",
  "description": "Cross-platform mobile test automation (Android + iOS) with Appium, WebdriverIO, TypeScript and the Page Object Model, running on emulators/simulators and in GitHub Actions CI.",
  "author": "Diego Villalobos",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm run test:android",
    "test:android": "bash scripts/run-android-tests.sh",
    "test:ios": "bash scripts/run-ios-tests.sh",
    "appium:start": "bash scripts/appium-start.sh",
    "appium:stop": "bash scripts/appium-stop.sh",
    "apps:download": "bash scripts/download-apps.sh",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile-automation",
    "android",
    "ios",
    "uiautomator2",
    "xcuitest",
    "page-object-model",
    "typescript",
    "github-actions"
  ],
  "overrides": {
    "@puppeteer/browsers": "3.2.3",
    "serialize-javascript": "7.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.13.2",
    "dotenv": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
